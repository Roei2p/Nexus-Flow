# Nexus-Flow FastAPI Backend Environment Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexus_flow
# For local SQLite development:
# DATABASE_URL=sqlite+aiosqlite:///./nexus_flow.db

# n8n Service Connection
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# LLM Providers
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# App Security
SECRET_KEY=nexus-flow-production-secret-key-32-chars
DEBUG=true
