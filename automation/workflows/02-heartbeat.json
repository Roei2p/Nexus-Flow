{
  "name": "Nexus - Heartbeat",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": 1 }
          ]
        }
      },
      "id": "c2d0f0a2-0001-4000-8000-000000000001",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "event", "value": "heartbeat", "type": "string" },
            { "id": "a2", "name": "workflow", "value": "={{ $workflow.name }}", "type": "string" },
            { "id": "a3", "name": "source", "value": "n8n:schedule", "type": "string" },
            { "id": "a4", "name": "at", "value": "={{ $now.toISO() }}", "type": "string" },
            { "id": "a5", "name": "executionId", "value": "={{ $execution.id }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "c2d0f0a2-0002-4000-8000-000000000002",
      "name": "Build Event",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://nexus:3000/api/events",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "c2d0f0a2-0003-4000-8000-000000000003",
      "name": "Send to Nexus",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0]
    }
  ],
  "connections": {
    "Every Minute": {
      "main": [[{ "node": "Build Event", "type": "main", "index": 0 }]]
    },
    "Build Event": {
      "main": [[{ "node": "Send to Nexus", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
