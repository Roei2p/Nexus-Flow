{
  "name": "Nexus - Email Notify",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "nexus-email",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "e1a0f0a3-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "event", "value": "email.notify", "type": "string" },
            { "id": "a2", "name": "workflow", "value": "={{ $workflow.name }}", "type": "string" },
            { "id": "a3", "name": "source", "value": "n8n:webhook", "type": "string" },
            { "id": "a4", "name": "at", "value": "={{ $now.toISO() }}", "type": "string" },
            { "id": "a5", "name": "subject", "value": "Nexus-Flow event", "type": "string" },
            { "id": "a6", "name": "message", "value": "={{ 'Event from ' + $workflow.name + ' at ' + $now.toISO() + '\\nPayload: ' + JSON.stringify($('Webhook').item.json.body) }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "e1a0f0a3-0002-4000-8000-000000000002",
      "name": "Build Event",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 0]
    },
    {
      "parameters": {
        "resource": "email",
        "operation": "send",
        "fromEmail": "nexus@example.com",
        "toEmail": "you@example.com",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.message }}"
      },
      "id": "e1a0f0a3-0003-4000-8000-000000000003",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [480, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://nexus:3000/api/events",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({}, $('Build Event').item.json, { channel: 'email', status: 'sent' })) }}",
        "options": {}
      },
      "id": "e1a0f0a3-0004-4000-8000-000000000004",
      "name": "Notify Nexus",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 0]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Build Event", "type": "main", "index": 0 }]] },
    "Build Event": { "main": [[{ "node": "Send Email", "type": "main", "index": 0 }]] },
    "Send Email": { "main": [[{ "node": "Notify Nexus", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
