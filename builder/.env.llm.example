# LLM key for the builder - pick ONE and uncomment.
# The builder detects whichever is present. Restart Docker after editing.
#
#OPENAI_API_KEY=sk-...
#ANTHROPIC_API_KEY=sk-ant-...
#OPENROUTER_API_KEY=sk-or-...
#GEMINI_API_KEY=AIza...
#OLLAMA_HOST=http://host.docker.internal:11434
#
# Optional override of the default model
#NEXUS_LLM_MODEL=gpt-4o-mini
